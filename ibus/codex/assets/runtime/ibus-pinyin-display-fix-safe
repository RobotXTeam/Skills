#!/usr/bin/env bash
set -u

APP_NAME="输入法拼音显示修复（安全版）"
STATE_DIR="$HOME/.local/state/ibus-pinyin-display-fix-safe"
mkdir -p "$STATE_DIR"

timestamp="$(date +%Y%m%d-%H%M%S)"
backup="$STATE_DIR/settings-$timestamp.txt"
log="$STATE_DIR/run-$timestamp.log"
status="$STATE_DIR/status-$timestamp.txt"
: >"$status"

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

info() {
  if has_cmd zenity; then
    zenity --info --title="$APP_NAME" --width=460 --text="$1" 2>/dev/null || true
  else
    printf '%s\n' "$1"
  fi
}

error_box() {
  if has_cmd zenity; then
    zenity --error --title="$APP_NAME" --width=520 --text="$1" 2>/dev/null || true
  else
    printf 'ERROR: %s\n' "$1" >&2
  fi
}

confirm() {
  if has_cmd zenity; then
    zenity --question \
      --title="$APP_NAME" \
      --width=520 \
      --ok-label="完整修复" \
      --cancel-label="取消" \
      --text="将执行以下操作：\n\n- 备份当前输入法与显示设置\n- 修正中文字体和 IBus 候选面板\n- 无损重载 libpinyin（不停止 IBus 服务）\n- 在 Xorg 下安全重载 GNOME 桌面文字绘制缓存\n\n首次运行会自动打开运行框、输入 r 并重载，用于激活后台组件；以后改为后台重载。桌面会短暂闪一下，不会改动缩放与横竖屏，已打开的应用和进程会保留。"
  else
    return 0
  fi
}

reload_libpinyin_safely() {
  local temporary_engine="xkb:us::eng"

  if has_cmd systemctl && systemctl --user cat org.freedesktop.IBus.session.GNOME.service >/dev/null 2>&1; then
    systemctl --user is-active --quiet org.freedesktop.IBus.session.GNOME.service || return 1
  fi

  # 切走再切回会重新加载 libpinyin 引擎，但不会停止 IBus 总服务。
  ibus engine "$temporary_engine" >/tmp/ibus-pinyin-display-fix-safe-temporary-engine.out 2>/tmp/ibus-pinyin-display-fix-safe-temporary-engine.err || return 1
  sleep 1
  ibus engine libpinyin >/tmp/ibus-pinyin-display-fix-safe-engine.out 2>/tmp/ibus-pinyin-display-fix-safe-engine.err || return 1

  for _ in 1 2 3 4 5; do
    if ibus engine 2>/dev/null | grep -qx 'libpinyin'; then
      return 0
    fi
    sleep 1
  done
  return 1
}

reload_gnome_shell_safely() {
  local reload_output

  if [ "${XDG_SESSION_TYPE:-}" != "x11" ]; then
    echo "skip GNOME Shell reload: not an Xorg session"
    return 0
  fi
  if ! has_cmd gdbus || ! pgrep -x gnome-shell >/dev/null 2>&1; then
    echo "failed GNOME Shell reload: gdbus or GNOME Shell unavailable"
    return 1
  fi

  echo "try safe reload GNOME Shell through the background helper"
  if gdbus call --session \
    --dest org.gnome.Shell \
    --object-path /com/steven/SafeShellReload \
    --method com.steven.SafeShellReload.Reload \
    >/tmp/ibus-pinyin-display-fix-shell-reload.out \
    2>/tmp/ibus-pinyin-display-fix-shell-reload.err; then
    sleep 8
    return 0
  fi

  if ! has_cmd xdotool || ! has_cmd gnome-extensions; then
    echo "failed first-time activation: xdotool or gnome-extensions unavailable"
    return 1
  fi

  echo "first-time activation via visible Alt+F2 r"
  xdotool key --clearmodifiers alt+F2
  sleep 1
  xdotool type --clearmodifiers --delay 120 r
  sleep 1
  xdotool key Return
  sleep 8

  gnome-extensions enable safe-shell-reload@steven.local || return 1
  sleep 2
  reload_output="$(gdbus introspect --session \
    --dest org.gnome.Shell \
    --object-path /com/steven/SafeShellReload 2>/dev/null || true)"
  grep -q 'com.steven.SafeShellReload' <<<"$reload_output"
}

run_fix() {
  {
    echo "[$(date '+%F %T')] start"
    echo "backup=$backup"
    echo "log=$log"
    echo "session_type=${XDG_SESSION_TYPE:-unknown}"
    echo "desktop_session=${DESKTOP_SESSION:-unknown}"
    echo

    {
      echo "# created: $(date '+%F %T')"
      echo "# session"
      echo "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-}"
      echo "DESKTOP_SESSION=${DESKTOP_SESSION:-}"
      echo "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-}"
      echo
      echo "# GNOME display settings"
      gsettings get org.gnome.mutter experimental-features 2>/dev/null || true
      gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null || true
      gsettings get org.gnome.desktop.interface scaling-factor 2>/dev/null || true
      echo
      echo "# input sources"
      gsettings get org.gnome.desktop.input-sources sources 2>/dev/null || true
      echo
      echo "# IBus settings"
      dconf dump /desktop/ibus/ 2>/dev/null || true
      echo
      echo "# ibus-libpinyin settings"
      dconf dump /com/github/libpinyin/ibus-libpinyin/ 2>/dev/null || true
      echo
      echo "# GNOME interface font settings"
      dconf dump /org/gnome/desktop/interface/ 2>/dev/null || true
    } >"$backup"

    echo "apply stable Chinese font settings"
    gsettings set org.gnome.desktop.interface font-name 'Noto Sans CJK SC 11'
    gsettings set org.gnome.desktop.interface document-font-name 'Noto Sans CJK SC 11'
    gsettings set org.gnome.desktop.interface monospace-font-name 'Noto Sans Mono CJK SC 13'
    gsettings set org.freedesktop.ibus.panel use-custom-font true
    gsettings set org.freedesktop.ibus.panel custom-font 'Noto Sans CJK SC 12'
    gsettings set org.freedesktop.ibus.panel use-glyph-from-engine-lang true

    echo "apply input method settings"
    gsettings set org.freedesktop.ibus.general embed-preedit-text false
    gsettings set org.freedesktop.ibus.general preload-engines "['libpinyin']"
    gsettings set org.gnome.desktop.input-sources sources "[('ibus', 'libpinyin'), ('xkb', 'cn')]"
    echo "rebuild font cache"
    fc-cache -r >/dev/null 2>&1 || true

    echo "reload libpinyin without stopping the IBus service"
    if ! reload_libpinyin_safely; then
      echo "warning: failed to reload libpinyin"
      echo "libpinyin 无损重载验证失败" >>"$status"
    fi

    # 通过本地 GNOME 辅助组件调用 Meta.restart，不显示 Alt+F2 运行框。
    # 绝不使用 gnome-shell --replace，不退出当前用户会话。
    if ! reload_gnome_shell_safely; then
      echo "warning: failed to reload GNOME Shell"
      echo "GNOME 桌面文字绘制缓存重载失败" >>"$status"
    fi

    echo
    echo "result"
    echo "experimental=$(gsettings get org.gnome.mutter experimental-features 2>/dev/null || true)"
    echo "text_scaling=$(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null || true)"
    echo "ui_font=$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null || true)"
    echo "candidate_font=$(gsettings get org.freedesktop.ibus.panel custom-font 2>/dev/null || true)"
    echo "use_candidate_font=$(gsettings get org.freedesktop.ibus.panel use-custom-font 2>/dev/null || true)"
    echo "sources=$(gsettings get org.gnome.desktop.input-sources sources 2>/dev/null || true)"
    echo "embed=$(gsettings get org.freedesktop.ibus.general embed-preedit-text 2>/dev/null || true)"
    echo "display=$(gsettings get com.github.libpinyin.ibus-libpinyin.libpinyin display-style 2>/dev/null || true)"
    echo "engine=$(ibus engine 2>/dev/null || true)"
    echo "[$(date '+%F %T')] done"
  } >"$log" 2>&1
}

if ! confirm; then
  exit 0
fi

if has_cmd zenity; then
  (
    echo "10"
    echo "# 正在备份并修复输入法显示..."
    run_fix
    echo "100"
    echo "# 完成"
  ) | zenity --progress \
      --title="$APP_NAME" \
      --width=460 \
      --text="正在修复..." \
      --percentage=0 \
      --auto-close \
      --no-cancel 2>/dev/null || true
else
  run_fix
fi

if [ -s "$status" ]; then
  error_box "修复未完整完成：\n\n$(cat "$status")\n\n请查看日志：$log"
  exit 1
fi

if ibus engine 2>/dev/null | grep -qx 'libpinyin'; then
  if has_cmd notify-send; then
    notify-send "$APP_NAME" "修复完成。请在新输入框里测试拼音显示。"
  fi
  info "修复完成。\n\n请在新打开的输入框里测试拼音显示。\n\n备份：$backup\n日志：$log"
else
  error_box "修复命令已执行，但当前 IBus 引擎不是 libpinyin。\n\n请查看日志：$log"
  exit 1
fi
